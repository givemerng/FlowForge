# Database
MYSQL_DATABASE=flowforge
MYSQL_USER=flowforge_user
MYSQL_PASSWORD=flowforge_password
MYSQL_ROOT_PASSWORD=root_password

# Security
JWT_SECRET=thisisaverysecuresecretkeythatshouldbeatleast256bitslongforhmacsha256
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_ERLANG_COOKIE=replace-with-a-long-random-cookie

# API
VITE_API_BASE_URL=http://localhost:8080/api

# Runtime profile and monitoring
SPRING_PROFILES_ACTIVE=prod
FLOWFORGE_LOG_LEVEL=INFO
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_RETENTION=30d
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=5

# Production deployment
FLOWFORGE_DOMAIN=flowforge.example.com
TLS_EMAIL=ops@example.com
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
